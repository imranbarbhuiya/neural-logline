{
  "name": "neural-logline",
  "version": "0.1.2",
  "description": "A tiny local model that extracts timestamps, levels, sources, and messages from log lines.",
  "author": "Parbez <imranbarbhuiya.fsd@gmail.com>",
  "homepage": "https://github.com/imranbarbhuiya/neural-logline#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imranbarbhuiya/neural-logline.git"
  },
  "bugs": {
    "url": "https://github.com/imranbarbhuiya/neural-logline/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "neural-logline": "dist/cli.js"
  },
  "files": ["dist", "MODEL_CARD.md", "LICENSE"],
  "sideEffects": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "test": "bun test",
    "train": "bun run training/train.ts",
    "evaluate": "bun run training/evaluate.ts",
    "benchmark": "bun run scripts/benchmark.ts",
    "privacy": "bun run scripts/privacy.ts",
    "check": "bun test && bun run evaluate && bun run build && bun run privacy",
    "prepack": "bun run check"
  },
  "keywords": ["logs", "parser", "machine-learning", "browser", "local-first", "typescript"]
}
